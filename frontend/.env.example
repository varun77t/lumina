# Copy this file to frontend/.env and fill in your values.

# Supabase project used for sign-in (Project Settings -> API Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Backend API base URL. Local development uses the Vite proxy (/api -> http://127.0.0.1:8000).
# For a deployed frontend, set the backend's public URL, e.g. https://your-api.example.com/api
VITE_API_BASE_URL=/api

# Local development only: skip sign-in with a mock user (the backend must run with AUTH_BYPASS=true)
VITE_BYPASS_AUTH=false
