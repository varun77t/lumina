# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# Google AI Studio key used for embeddings and answers: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001

# Supabase project whose user access tokens the API accepts
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if the project still signs tokens with the legacy shared JWT secret
# (Project Settings -> JWT Keys). Projects on asymmetric signing keys are verified
# through the public JWKS endpoint and can leave this empty.
SUPABASE_JWT_SECRET=

# Local development only: skip token verification and treat every request as a dev user.
# Never enable this on a public server.
AUTH_BYPASS=false

# Comma-separated frontend origins allowed to call the API, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Directory for uploaded PDFs and vector indexes (defaults to the backend folder).
# Point this at a persistent disk in production, e.g. /var/data
# DATA_DIR=

# Largest accepted PDF upload, in megabytes
MAX_UPLOAD_MB=20
